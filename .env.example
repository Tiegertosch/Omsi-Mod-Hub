# Kopiere diese Datei nach `.env` und passe die Werte an.
# Echte Zugangsdaten niemals committen.
# Für den Server: deploy/env.production.example und docs/DEPLOYMENT.md.

# Datenbank
# Lokal: SQLite-Datei (Pfad relativ zum Projektverzeichnis).
DATABASE_URL="file:./prisma/dev.db"
# Später PostgreSQL, z. B.:
# DATABASE_URL="postgresql://USER:PASSWORT@localhost:5432/omsi_mod_hub?schema=public"

# Öffentliche Basis-URL der Seite (ohne abschließenden Slash).
# Wird für kanonische URLs, Sitemap und Open-Graph-Metadaten verwendet.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth
# Zufälliges Secret mit mindestens 32 Zeichen, z. B. erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="BITTE-ERSETZEN"
# Öffentliche URL der App; Grundlage für Links in E-Mails und die Origin-Prüfung.
BETTER_AUTH_URL="http://localhost:3000"

# Projekte: Müssen Einreichungen von einem Admin freigegeben werden? (Standard: true)
PROJECT_REVIEW_REQUIRED="true"

# Verzeichnis für hochgeladene Bilder (Standard: ./storage/uploads). Muss beschreibbar sein
# und bei mehreren Instanzen geteilt werden (bzw. später durch Objektspeicher ersetzt).
# UPLOAD_DIR="./storage/uploads"

# E-Mail-Versand: "file" (Entwicklung, ./.dev-mail), "console" (Entwicklung) oder "smtp".
MAIL_TRANSPORT="file"
# Nur für MAIL_TRANSPORT="smtp":
# SMTP_URL="smtps://BENUTZER:PASSWORT@smtp.example.com:465"
# MAIL_FROM="OMSI Mod Hub <no-reply@example.com>"
