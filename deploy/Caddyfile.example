# Caddy-Konfiguration (öffentlich erreichbar).
# Kopieren nach /etc/caddy/Caddyfile, Platzhalter ersetzen, dann:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy holt die TLS-Zertifikate (Let's Encrypt) automatisch, sobald die
# DNS-Einträge auf den Server zeigen und die Ports 80/443 offen sind.

{
	# Kontaktadresse für Let's Encrypt (Ablaufwarnungen)
	email ADMIN@EXAMPLE.COM
}

# Hauptadresse – muss NEXT_PUBLIC_SITE_URL und BETTER_AUTH_URL entsprechen.
EXAMPLE.COM {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Bild-Uploads laufen über Server Actions (Limit dort: 6 MB)
	request_body {
		max_size 8MB
	}

	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/omsi-mod-hub.log {
			roll_size 20MiB
			roll_keep 5
			# Zugriffslogs enthalten IP-Adressen: höchstens 14 Tage aufbewahren
			# (Caddy-Standard wären 90 Tage). Frist steht in der Datenschutzerklärung.
			roll_keep_for 336h
		}
	}
}

# Weitere Adressen leiten dauerhaft auf die Hauptadresse um; Pfad und Query
# bleiben erhalten (z. B. Links aus Mails der früheren Beta-Subdomain).
# Ohne frühere Beta die zweite Adresse einfach weglassen.
www.EXAMPLE.COM, beta.EXAMPLE.COM {
	redir https://EXAMPLE.COM{uri} permanent
}
