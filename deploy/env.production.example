# Produktions-Konfiguration für den Server.
# Ablage: /etc/omsi-mod-hub/env  (Besitzer omsi, Rechte 600) – niemals ins Repo.
# Wird von systemd (EnvironmentFile) und – über den Symlink .env in jedem
# Release – von pnpm-Skripten (Migrationen, Build, CLI) gelesen.
# Werte in doppelten Anführungszeichen; keine Variablen-Ersetzung ($…) verwenden.
# NODE_ENV hier nicht setzen: Das übernehmen systemd-Dienst und `next build`.

# Datenbank (PostgreSQL auf demselben Server, nur lokal erreichbar).
# Passwort beim Anlegen der Rolle erzeugen (siehe docs/DEPLOYMENT.md); nur
# Buchstaben und Ziffern verwenden, dann ist keine URL-Kodierung nötig.
DATABASE_URL="postgresql://omsi_mod_hub:PASSWORT@localhost:5432/omsi_mod_hub"

# Hochgeladene Bilder
UPLOAD_DIR="/var/lib/omsi-mod-hub/uploads"

# Öffentliche Adresse (ohne abschließenden Slash). NEXT_PUBLIC_SITE_URL wird
# beim Build eingebaut – nach einer Änderung neu deployen.
NEXT_PUBLIC_SITE_URL="https://EXAMPLE.COM"
BETTER_AUTH_URL="https://EXAMPLE.COM"

# Neu erzeugen (nicht das lokale Secret wiederverwenden):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="BITTE-ERSETZEN"
# Cap (CAPTCHA): ebenfalls neu erzeugen, eigenes Secret
CAP_SECRET="BITTE-ERSETZEN"

# Einreichungen brauchen eine Admin-Freigabe
PROJECT_REVIEW_REQUIRED="true"

# E-Mail über das Postfach des Mail-Anbieters.
# Port 465 → smtps://   Port 587 → smtp:// (STARTTLS wird automatisch genutzt)
# Sonderzeichen in Benutzer/Passwort URL-kodieren: @ → %40, : → %3A, / → %2F, # → %23, % → %25
# Testen mit:  pnpm mail:test deine@adresse.de
MAIL_TRANSPORT="smtp"
SMTP_URL="smtps://NO-REPLY%40EXAMPLE.COM:PASSWORT@SMTP.EXAMPLE.COM:465"
# Absender muss zum Postfach passen, sonst lehnen viele Anbieter ab
MAIL_FROM="OMSI Mod Hub <no-reply@EXAMPLE.COM>"
# Pause zwischen zwei Sendungen der Mail-Warteschlange (Millisekunden, Standard 2000)
# MAIL_SEND_INTERVAL_MS="2000"

# Backup zusätzlich auf eine Hetzner Storage Box kopieren (docs/DEPLOYMENT.md, Betrieb).
# Ohne diesen Eintrag bleiben die Backups nur auf dem Server.
# BACKUP_REMOTE="uXXXXX@uXXXXX.your-storagebox.de:omsi-mod-hub/"
# BACKUP_SSH_KEY="/home/omsi/.ssh/storagebox_ed25519"
# Optional: Heartbeat-URL eines Monitoring-Dienstes (z. B. Better Stack), siehe
# docs/DEPLOYMENT.md, Abschnitt Monitoring. Ohne Schrägstrich am Ende.
# BACKUP_HEARTBEAT_URL="https://uptime.betterstack.com/api/v1/heartbeat/XXXXXXXX"
