# Produktions-Konfiguration für den Server.
# Ablage: /etc/omsi-mod-hub/env  (Besitzer omsi, Rechte 600) – niemals ins Repo.
# Wird von systemd (EnvironmentFile) und – über den Symlink .env in jedem
# Release – von pnpm-Skripten (Migrationen, Build, CLI) gelesen.
# Werte in doppelten Anführungszeichen; keine Variablen-Ersetzung ($…) verwenden.
# NODE_ENV hier nicht setzen: Das übernehmen systemd-Dienst und `next build`.

# Datenbank (SQLite, absoluter Pfad)
DATABASE_URL="file:/var/lib/omsi-mod-hub/db/omsi.db"

# Hochgeladene Bilder
UPLOAD_DIR="/var/lib/omsi-mod-hub/uploads"

# Öffentliche Adresse (ohne abschließenden Slash). NEXT_PUBLIC_SITE_URL wird
# beim Build eingebaut – nach einer Änderung neu deployen.
NEXT_PUBLIC_SITE_URL="https://BETA.EXAMPLE.COM"
BETTER_AUTH_URL="https://BETA.EXAMPLE.COM"

# Neu erzeugen (nicht das lokale Secret wiederverwenden):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="BITTE-ERSETZEN"

# Einreichungen brauchen eine Admin-Freigabe
PROJECT_REVIEW_REQUIRED="true"

# E-Mail über das Postfach des Mail-Anbieters.
# Port 465 → smtps://   Port 587 → smtp:// (STARTTLS wird automatisch genutzt)
# Sonderzeichen in Benutzer/Passwort URL-kodieren: @ → %40, : → %3A, / → %2F, # → %23, % → %25
# Testen mit:  pnpm mail:test deine@adresse.de
MAIL_TRANSPORT="smtp"
SMTP_URL="smtps://NO-REPLY%40EXAMPLE.COM:PASSWORT@SMTP.EXAMPLE.COM:465"
# Absender muss zum Postfach passen, sonst lehnen viele Anbieter ab
MAIL_FROM="OMSI Mod Hub <no-reply@EXAMPLE.COM>"
